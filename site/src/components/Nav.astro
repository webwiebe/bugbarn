---
const base = import.meta.env.BASE_URL;
---
<nav style="border-bottom: 1px solid #21262d; background-color: #0f1117;">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 sm:h-14 flex flex-wrap sm:flex-nowrap items-center justify-between">
    <a href={base} class="font-mono text-lg font-semibold tracking-tight inline-flex items-center min-h-[44px]" style="color: #d4a054;">BugBarn</a>
    <div class="order-3 sm:order-2 sm:ml-auto w-full sm:w-auto flex flex-wrap items-center gap-x-1 sm:gap-x-6 text-sm whitespace-nowrap" style="color: #8b949e;">
      <a href="#features" class="inline-flex items-center min-h-[44px] px-2 sm:px-0 hover:text-white transition-colors">Features</a>
      <a href="#install" class="inline-flex items-center min-h-[44px] px-2 sm:px-0 hover:text-white transition-colors">Install</a>
      <a href={`${base}/docs/`} class="inline-flex items-center min-h-[44px] px-2 sm:px-0 hover:text-white transition-colors">Docs</a>
      <a href="/app/" class="inline-flex items-center min-h-[44px] px-2 sm:px-0 hover:text-white transition-colors" style="color: #d4a054;">Open dashboard →</a>
    </div>
    <a href="https://github.com/webwiebe/bugbarn" class="order-2 sm:order-3 sm:ml-6 hover:text-white transition-colors inline-flex items-center justify-center gap-1.5 min-h-[44px] min-w-[44px]" style="color: #8b949e;" target="_blank" rel="noopener" aria-label="GitHub">
      <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
      <span class="hidden sm:inline text-sm">GitHub</span>
    </a>
  </div>
</nav>
